{
  "name": "traffic-study-mysql-connector",
  // 👆 Kafka Connect에 등록될 커넥터의 고유 이름
  //    - 이 이름으로 상태 확인, 삭제 등의 작업 수행
  //    - 예: curl http://localhost:8083/connectors/traffic-study-mysql-connector/status

  "config": {

    // ========== 1️⃣ 커넥터 기본 설정 ==========

    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    // 👆 사용할 Debezium 커넥터 클래스 지정
    //    MySQL용 Debezium 커넥터를 사용한다는 의미

    "tasks.max": "1",
    // 👆 동시에 실행될 태스크 수
    //    - "1": 단일 태스크로 실행 (일반적으로 권장)
    //    - 값을 늘리면 병렬 처리 가능하지만, binlog는 순차적이므로 1이 적합

    // ========== 2️⃣ MySQL 데이터베이스 연결 설정 ==========

    "database.hostname": "mysql",
    // 👆 MySQL 서버의 호스트명
    //    Docker 네트워크 내에서 컨테이너 이름 "mysql"로 접근

    "database.port": "3306",
    // 👆 MySQL 서버 포트 (컨테이너 내부 포트)

    "database.user": "study",
    // 👆 MySQL 접속 계정
    //    REPLICATION CLIENT, REPLICATION SLAVE 권한 필요

    "database.password": "traffic",
    // 👆 MySQL 계정 비밀번호

    "database.server.id": "184054",
    // 👆 Debezium이 MySQL에 연결할 때 사용할 고유 서버 ID
    //    - MySQL의 server-id와 달라야 함 (충돌 방지)
    //    - MySQL 설정의 server-id=1과 다른 값 사용

    // ========== 3️⃣ 토픽 및 스키마 설정 ==========

    "topic.prefix": "traffic-study",
    // 👆 Kafka 토픽 이름의 접두사
    //    최종 토픽명: {topic.prefix}.{database}.{table}
    //    예: traffic-study.traffic_study.sign_up_event

    "database.include.list": "traffic_study",
    // 👆 CDC를 적용할 데이터베이스 목록 (쉼표로 구분 가능)
    //    지정된 데이터베이스만 모니터링

    "table.include.list": "traffic_study.outbox",
    // 👆 CDC를 적용할 테이블 목록 (쉼표로 구분 가능)
    //    형식: {database}.{table}
    //    이 테이블만 변경사항을 Kafka로 전송

    // ========== 4️⃣ 스키마 히스토리 설정 ==========

    "schema.history.internal.kafka.bootstrap.servers": "kafka-1:9092,kafka-2:9092,kafka-3:9092",
    // 👆 스키마 변경 이력을 저장할 Kafka 클러스터 주소
    //    Docker 네트워크 내부 주소 사용 (컨테이너 간 통신)

    "schema.history.internal.kafka.topic": "traffic-study.schema-changes",
    // 👆 스키마 변경 이력이 저장될 Kafka 토픽 이름
    //    ALTER TABLE 같은 DDL 변경사항을 추적

    "include.schema.changes": "true",
    // 👆 스키마 변경 이벤트도 Kafka로 발행할지 여부
    //    - "true": DDL 변경도 이벤트로 전송
    //    - "false": 데이터 변경만 전송

    // ========== 5️⃣ 데이터 변환(Transform) 설정 ==========

    "transforms": "unwrap",
    // 👆 적용할 Transform의 이름 (여러 개는 쉼표로 구분)
    //    "unwrap"이라는 Transform을 적용

    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    // 👆 unwrap Transform의 실제 클래스
    //    Debezium의 복잡한 래핑 구조를 단순화
    //    전: {"before": {...}, "after": {...}, "op": "c"}
    //    후: {...} (after 값만 추출)

    "transforms.unwrap.add.fields": "op",
    // c	Create	데이터가 신규로 Insert 됨
    // u	Update	기존 데이터가 Update 됨
    // d	Delete	데이터가 Delete 됨
    // r	Read	스냅샷(초기 로딩)을 통해 읽어온 데이터

    "transforms.unwrap.drop.tombstones": "false",
    // 👆 DELETE 후 생성되는 tombstone 메시지를 삭제할지 여부
    //    - "false": tombstone 유지 (로그 컴팩션에 필요)
    //    - "true": tombstone 제거

    "transforms.unwrap.delete.handling.mode": "rewrite",
    // 👆 DELETE 이벤트 처리 방식
    //    - "rewrite": 삭제된 레코드 정보를 포함하여 재작성
    //    - "drop": DELETE 이벤트 무시
    //    - "none": 원본 그대로 (before 값 포함)

    // ========== 6️⃣ 데이터 직렬화 설정 ==========

    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    // 👆 메시지 키를 JSON으로 직렬화
    //    보통 Primary Key가 키로 사용됨

    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    // 👆 메시지 값을 JSON으로 직렬화
    //    변경된 레코드 데이터

    "key.converter.schemas.enable": "false",
    // 👆 키에 스키마 정보를 포함하지 않음
    //    - "false": {"id": 1} (순수 데이터만)
    //    - "true": {"schema": {...}, "payload": {"id": 1}} (스키마 포함)

    "value.converter.schemas.enable": "false",
    // 👆 값에 스키마 정보를 포함하지 않음
    //    JSON이 더 간결해지고 읽기 쉬워짐

    // ========== 7️⃣ 스냅샷(초기 로드) 설정 ==========

    "snapshot.mode": "initial",
    // 👆 커넥터 시작 시 기존 데이터를 어떻게 처리할지 결정
    //    - "initial": 처음 시작 시 전체 데이터 스냅샷 → 이후 binlog 읽기
    //    - "schema_only": 스키마만 읽고 데이터는 스냅샷 안 함
    //    - "never": 스냅샷 없이 현재 binlog부터 시작
    //    - "when_needed": offset이 없을 때만 스냅샷

    "snapshot.locking.mode": "minimal"
    // 👆 스냅샷 시 테이블 잠금 방식
    //    - "minimal": 최소한의 잠금만 사용 (짧은 시간만 읽기 잠금)
    //    - "none": 잠금 없음 (일관성 낮음)
    //    - "extended": 스냅샷 동안 계속 잠금 (일관성 높지만 성능 저하)
  }
}